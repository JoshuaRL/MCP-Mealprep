# Copy to .env and adjust. Every value here has a safe default; .env
# itself is git-ignored and never committed.

# Images (pull-and-go). Override to pin a digest for reproducibility:
MEALPREP_IMAGE=ghcr.io/joshuarl/mcp-mealprep:main
BASEROW_MCP_IMAGE=ghcr.io/joshuarl/mcp-mealprep:baserow-main

# Where secret files live. Defaults to ./secrets (git-ignored real dir);
# point at ./examples/run/secrets for the dummy-placeholder flow.
MEALPREP_SECRET_DIR=./examples/run/secrets
BASEROW_SECRETS_DIR=./examples/run/secrets

# SearXNG base URL for the mcp-mealprep-searxng service.
# Must be a JSON-capable instance — see examples/searxng/README.md.
SEARXNG_INSTANCE_URL=http://127.0.0.1:8888
