{
  "name": "baserow-streamable-mcp",
  "version": "0.1.0",
  "description": "A remote MCP server for Baserow using Streamable HTTP and the Baserow REST API.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "baserow",
    "mcp",
    "model-context-protocol",
    "streamable-http"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.9.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
